  "staples": {
    "_comment": "Well-known, easy-to-coach exercises get a selection bonus so plans read like a coach wrote them.",
    "bonus": 4,
    "patterns": {
      "squat": "^(goblet squat|dumbbell squat|barbell (full )?squat|front barbell squat|barbell front squat|leg press|bodyweight squat|smith machine squat|kettlebell goblet squat)",
      "hinge": "^(romanian deadlift|stiff[- ]legged (dumbbell|barbell) deadlift|barbell deadlift|barbell hip thrust|glute bridge|butt lift|one-arm kettlebell swings|kettlebell swing|good ?morning|single[- ]leg deadlift|dumbbell romanian)",
      "push-h": "^(push-?ups?|pushups|barbell bench press|dumbbell bench press|incline dumbbell press|incline push-?up|dips - chest|machine bench press|leverage chest press|chest press)",
      "push-v": "^(dumbbell shoulder press|seated dumbbell press|standing dumbbell press|barbell shoulder press|military press|standing military press|arnold dumbbell press|pike|machine shoulder)",
      "pull-h": "^(bent over barbell row|bent over two-dumbbell row$|one-arm dumbbell row|seated cable rows?|inverted row|t-bar row|chest[- ]supported|lying t-bar|dumbbell incline row)",
      "pull-v": "^(pull-?ups?|pullups|chin-?ups?|wide-grip lat pulldown|close-grip front lat pulldown|full range-of-motion lat pulldown|band assisted pull-up)",
      "lunge": "^(dumbbell lunges|barbell lunge|bodyweight walking lunge|barbell walking lunge|split squats?|dumbbell step ups|barbell step ups|bodyweight lunge|reverse lunge|dumbbell rear lunge)",
      "core": "^(plank|dead bug|bird dog|pallof press|hanging leg raise|ab roller|side bridge|crunches|mountain climbers|cross-body crunch|russian twist|air bike)",
      "carry": "farmer",
      "isolation": "^(side lateral raise|lateral raise|dumbbell bicep curl|hammer curls|dumbbell alternate bicep curl|triceps pushdown|tricep dumbbell kickback|lying leg curls|seated leg curl|leg extensions|standing calf raises|seated calf raise|face pull|reverse flyes|dumbbell flyes|cable crossover)"
    },
    "variantPenalty": {
      "_comment": "Unusual variants lose points on main/supporting slots so the standard lift wins.",
      "regex": "decline|wide-grip|close-grip|reverse grip|one[- ]arm|single[- ]arm|kneeling|elevated|with (a )?bands?|bosu|exercise ball|on (a )?ball|chains|gorilla|flutter|kickback|leg lift|scissor|speed|jump|clean|snatch",
      "compound": 3,
      "accessory": 1
    },
    "repeatPenalty": 3
  },
  "needsBar": {
    "_comment": "free-exercise-db labels these 'body only', but they need a pull-up / dip bar. Allowed when the user has a pull-up bar or trains at a gym (machine, cable or barbell).",
    "names": "pull-?ups?|pullups|chin-?ups?|chinups|hanging|muscle[- ]?up|dips?\b|toes to bar",
