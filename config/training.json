  "periodization": {
    "_comment": "Weeks cycle through accumulation (volume up), intensification (reps down, effort up) and a deload every 4th week (fewer sets, lower effort). setsDelta applies to the main lifts (priority-1 slots); repShift moves the rep range down by that many reps.",
    "blockLength": 4,
    "pattern": [
      {
        "phase": "accumulation",
        "setsDelta": 0,
        "rpeDelta": -0.5,
        "repShift": 0,
        "note": "Learn the movements; leave a couple of reps in the tank."
      },
      {
        "phase": "accumulation",
        "setsDelta": 1,
        "rpeDelta": 0,
        "repShift": 0,
        "note": "One more set on the main lifts."
      },
      {
        "phase": "intensification",
        "setsDelta": 1,
        "rpeDelta": 0.5,
        "repShift": 2,
        "note": "Heavier: rep ranges drop, effort goes up."
      },
      {
        "phase": "deload",
        "setsDelta": -1,
        "rpeDelta": -1.5,
        "repShift": 0,
        "note": "Deload: fewer sets and easier effort so you recover and come back stronger."
      }
    ]
  },
  "bodyTypeModulation": {
    "endomorph": {
      "cut": {
        "finisher": true,
