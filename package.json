{
  "name": "trainsync",
  "version": "2.0.0-dev",
  "description": "TrainSync — trainer matching, workout & diet planning",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest",
    "test:visual": "playwright test tests/visual",
    "test:e2e": "playwright test tests/e2e",
    "import:exercises": "node scripts/import/exercises.js",
    "import:gyms": "node scripts/import/gyms.js",
    "import:foods": "node scripts/import/foods.js",
    "import:localities": "node scripts/import/localities.js",
    "import:ipip": "node scripts/import/ipip.js",
    "import:all": "npm run import:exercises && npm run import:gyms && npm run import:foods && npm run import:ipip",
    "seed": "node scripts/seed/index.js",
    "seed:synthetic": "node scripts/seed/synthetic.js",
    "purge:synthetic": "node scripts/seed/purge.js",
    "test:ml": "node scripts/py.js -m pytest ml/tests -q",
    "test:load": "node tests/load/login.js",
    "start:cluster": "node cluster.js",
    "lint": "eslint . && node scripts/py.js -m ruff check ml",
    "vercel-build": "node scripts/migrate.js",
    "assets": "node scripts/build-assets.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "highs": "^1.15.3",
    "mysql2": "^3.24.4",
    "opossum": "^10.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "autocannon": "^8.0.0",
    "chart.js": "^4.5.1",
    "eslint": "^10.11.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "leaflet": "^1.9.4",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/tests/{api,unit}/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "maxWorkers": 1
  },
  "nodemonConfig": {
    "ignore": [
      "public/*",
      "tests/*",
      "ml/*",
      "backups/*"
    ]
  },
  "overrides": {
    "mysql2": "$mysql2",
    "hyperid": {
      "uuid": "^11.1.1"
    }
  }
}
