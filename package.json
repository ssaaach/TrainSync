{
  "name": "trainsync",
  "version": "2.0.0-dev",
  "description": "TrainSync — trainer matching, workout & diet planning",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest",
    "test:visual": "playwright test tests/visual",
    "test:e2e": "playwright test tests/e2e"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/tests/{api,unit}/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js"
  },
  "nodemonConfig": {
    "ignore": [
      "public/*",
      "tests/*",
      "ml/*",
      "backups/*"
    ]
  }
}
