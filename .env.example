# Copy to .env and fill in. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trainsync

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# development | production | test
NODE_ENV=development
PORT=5000

# Optional contact (email or URL) sent in the User-Agent of data-import
# requests (OpenStreetMap/Nominatim ask for one).
IMPORT_CONTACT=

# Password for the demo accounts created by `npm run seed`.
DEMO_PASSWORD=
