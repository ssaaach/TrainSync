# Copy to .env and fill in. Never commit .env. Validated at boot by config/env.js.

# --- Database (MySQL 8.0.19+ with spatial support; TiDB won't work) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trainsync
# Connections per process. Default 10 (server) / 3 (Vercel); cluster.js splits
# config.db.maxTotalConnections between workers automatically.
DB_POOL_SIZE=
# Managed MySQL (e.g. Aiven) needs TLS: DB_SSL=true and the CA certificate's
# PEM text in DB_SSL_CA (literal \n sequences are accepted).
DB_SSL=
DB_SSL_CA=

# --- Sessions: long random string (required in production, >= 32 chars) ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# development | production | test
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# Comma-separated origins allowed to call the API cross-origin with cookies.
# Dev default: the VS Code Live Server ports. Production default: none.
CORS_ORIGINS=
# Express "trust proxy" (number of hops, true/false, or a subnet list).
TRUST_PROXY=

# --- Process sizing (long-running server only) ---
WEB_CONCURRENCY=
UV_THREADPOOL_SIZE=

# --- Optional services ---
# Python embedding service (ml/service). Unset = lexical similarity fallback.
ML_SERVICE_URL=
# Local Ollama for rephrasing plan explanations only. Unset = templates.
OLLAMA_URL=
# Bearer secret Vercel Cron (or any scheduler) sends to /api/cron/*.
CRON_SECRET=

# Optional contact (email or URL) sent in the User-Agent of data-import
# requests (OpenStreetMap/Nominatim ask for one).
IMPORT_CONTACT=

# Password for the demo accounts created by `npm run seed`.
DEMO_PASSWORD=
